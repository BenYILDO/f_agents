//@version=5
// ============================================================================
// Dip-Al BIST Tarayıcı (Tablo)  — çok sembollü ekran tarayıcı
// 20 hissenin GÜNCEL durumunu (AL / SAT / NÖTR) tek tabloda gösterir.
// Mantık dip_al_sinyal.pine ile aynı (SMI 10-3-3 + VWMA7 + Bollinger 20).
//
// Kullanım: grafiğe ekle; sağ üstte tablo çıkar. Zaman dilimi = grafiğin dilimi
// (Günlük/4s önerilir). Semboller ayarlardan değiştirilebilir. Yatırım tavsiyesi değildir.
// ============================================================================
indicator("Dip-Al BIST Tarayıcı (Tablo)", overlay=true)

kLen    = input.int(10,  "SMI %K", group="Parametreler")
dLen    = input.int(3,   "SMI %D", group="Parametreler")
sigLen  = input.int(3,   "Sinyal EMA", group="Parametreler")
vwmaLen = input.int(7,   "SMI VWMA", group="Parametreler")
bbLen   = input.int(20,  "Bollinger", group="Parametreler")
bbMult  = input.float(2.0, "BB StdDev", group="Parametreler")
armBars = input.int(8,    "Dip penceresi", group="Parametreler")
minGap  = input.float(2.0,"Min SMI-VWMA farkı", group="Parametreler")
entryCeil=input.float(40.0,"AL üst SMI sınırı", group="Parametreler")
scoreLen= input.int(14,   "Fiyat skoru uzunluğu", group="Parametreler")
minSell = input.int(2,    "Min SAT teyidi", group="Parametreler")
zoneBars= input.int(3,    "AL/SAT bölgesi penceresi (bar)", group="Parametreler",
   tooltip="Son kaç bar içinde sinyal oluşmuşsa hisse hâlâ AL/SAT bölgesi sayılsın")

// Durum hesabı: 1=AL bölgesi, -1=SAT bölgesi, 0=NÖTR (+ kapanış).
// PRO mantık (dip_al_sinyal.pine ile aynı): teyitli + dip döngüsünde tek sinyal,
// üstüne "son N barda sinyal mi" bölge sarmalayıcısı — yoksa tablo hep NÖTR olurdu.
f_status() =>
    hh    = ta.highest(high, kLen)
    ll    = ta.lowest(low,  kLen)
    rel   = close - (hh + ll) / 2.0
    rng   = hh - ll
    sRel  = ta.ema(ta.ema(rel, dLen), dLen)
    sRng  = ta.ema(ta.ema(rng, dLen), dLen)
    smi   = sRng != 0 ? 100.0 * sRel / (sRng / 2.0) : 0.0
    sig   = ta.ema(smi, sigLen)
    vw    = ta.vwma(smi, vwmaLen)
    basis = ta.sma(close, bbLen)
    dev   = bbMult * ta.stdev(close, bbLen)
    upper = basis + dev
    score = ta.stoch(close, high, low, scoreLen)
    // AL (teyitli, dip döngüsünde tek)
    newDip = ta.crossover(smi, sig) and smi < 0
    var bool bFired = false
    if newDip
        bFired := false
    inWin = not na(ta.barssince(newDip)) and ta.barssince(newDip) <= armBars
    buy = inWin and not bFired and ta.crossover(smi, vw) and (smi - vw) >= minGap and smi > smi[1] and smi < entryCeil and close > basis
    if buy
        bFired := true
    // SAT (teyitli, yükseliş döngüsünde tek)
    conf = (close >= upper*0.99 ? 1 : 0) + (volume < ta.sma(volume,5) ? 1 : 0) + (score > 50 ? 1 : 0)
    var bool sFired = false
    if smi < 0
        sFired := false
    sell = ta.crossunder(smi, sig) and smi > 0 and conf >= minSell and not sFired
    if sell
        sFired := true
    // Bölge sarmalayıcı
    inBuy  = (not na(ta.barssince(buy))  and ta.barssince(buy)  <= zoneBars)
    inSell = (not na(ta.barssince(sell)) and ta.barssince(sell) <= zoneBars)
    st     = inBuy ? 1 : inSell ? -1 : 0
    [st, close]

f_get(simple string sym) => request.security(sym, timeframe.period, f_status())

// ── Taranacak 20 hisse (ayarlardan değiştir) ─────────────────────────────────
g = "Hisseler"
s01=input.symbol("BIST:THYAO",   "01", group=g),  s02=input.symbol("BIST:GARAN","02",group=g)
s03=input.symbol("BIST:AKBNK",   "03", group=g),  s04=input.symbol("BIST:ISCTR","04",group=g)
s05=input.symbol("BIST:YKBNK",   "05", group=g),  s06=input.symbol("BIST:SAHOL","06",group=g)
s07=input.symbol("BIST:KCHOL",   "07", group=g),  s08=input.symbol("BIST:TUPRS","08",group=g)
s09=input.symbol("BIST:EREGL",   "09", group=g),  s10=input.symbol("BIST:BIMAS","10",group=g)
s11=input.symbol("BIST:SISE",    "11", group=g),  s12=input.symbol("BIST:ASELS","12",group=g)
s13=input.symbol("BIST:TCELL",   "13", group=g),  s14=input.symbol("BIST:FROTO","14",group=g)
s15=input.symbol("BIST:TOASO",   "15", group=g),  s16=input.symbol("BIST:ARCLK","16",group=g)
s17=input.symbol("BIST:PGSUS",   "17", group=g),  s18=input.symbol("BIST:KRDMD","18",group=g)
s19=input.symbol("BIST:SASA",    "19", group=g),  s20=input.symbol("BIST:HEKTS","20",group=g)

[st01,c01]=f_get(s01), [st02,c02]=f_get(s02), [st03,c03]=f_get(s03), [st04,c04]=f_get(s04)
[st05,c05]=f_get(s05), [st06,c06]=f_get(s06), [st07,c07]=f_get(s07), [st08,c08]=f_get(s08)
[st09,c09]=f_get(s09), [st10,c10]=f_get(s10), [st11,c11]=f_get(s11), [st12,c12]=f_get(s12)
[st13,c13]=f_get(s13), [st14,c14]=f_get(s14), [st15,c15]=f_get(s15), [st16,c16]=f_get(s16)
[st17,c17]=f_get(s17), [st18,c18]=f_get(s18), [st19,c19]=f_get(s19), [st20,c20]=f_get(s20)

// ── Tablo ────────────────────────────────────────────────────────────────────
var table tbl = table.new(position.top_right, 3, 22, border_width=1, frame_width=1,
   frame_color=color.gray)

f_label(st) => st == 1 ? "AL" : st == -1 ? "SAT" : "—"
f_col(st)   => st == 1 ? color.new(color.green, 0) : st == -1 ? color.new(color.red, 0) : color.new(color.gray, 40)

f_row(int idx, simple string sym, int st, float c) =>
    nm = str.replace(sym, "BIST:", "")
    table.cell(tbl, 0, idx, nm, text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, idx, f_label(st), text_color=color.white, bgcolor=f_col(st))
    table.cell(tbl, 2, idx, str.tostring(c, format.mintick), text_color=color.white)

if barstate.islast
    table.cell(tbl, 0, 0, "Hisse", text_color=color.white, bgcolor=color.new(color.blue, 0))
    table.cell(tbl, 1, 0, "Durum", text_color=color.white, bgcolor=color.new(color.blue, 0))
    table.cell(tbl, 2, 0, "Fiyat", text_color=color.white, bgcolor=color.new(color.blue, 0))
    f_row(1,  s01, st01, c01),  f_row(2,  s02, st02, c02),  f_row(3,  s03, st03, c03)
    f_row(4,  s04, st04, c04),  f_row(5,  s05, st05, c05),  f_row(6,  s06, st06, c06)
    f_row(7,  s07, st07, c07),  f_row(8,  s08, st08, c08),  f_row(9,  s09, st09, c09)
    f_row(10, s10, st10, c10),  f_row(11, s11, st11, c11),  f_row(12, s12, st12, c12)
    f_row(13, s13, st13, c13),  f_row(14, s14, st14, c14),  f_row(15, s15, st15, c15)
    f_row(16, s16, st16, c16),  f_row(17, s17, st17, c17),  f_row(18, s18, st18, c18)
    f_row(19, s19, st19, c19),  f_row(20, s20, st20, c20)

// AL bölgesindekiler için alarm (herhangi biri AL olunca)
anyBuy = (st01==1)or(st02==1)or(st03==1)or(st04==1)or(st05==1)or(st06==1)or(st07==1)or(st08==1)or(st09==1)or(st10==1)or(st11==1)or(st12==1)or(st13==1)or(st14==1)or(st15==1)or(st16==1)or(st17==1)or(st18==1)or(st19==1)or(st20==1)
alertcondition(anyBuy, "BIST'te AL sinyali", "Taranan BIST hisselerinden birinde AL sinyali oluştu")
